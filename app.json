{
  "expo": {
    "name": "Stray Care",
    "slug": "stray-care",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "straycare",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.techforge.straycare",
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCv7X13DcKqsRx-LajzoyeWGOGVqBoOtuA"
        }
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/straycarelogo.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow StrayCare to access your photos.",
          "cameraPermission": "Allow StrayCare to use your camera."
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow StrayCare to use your camera for video calls.",
          "microphonePermission": "Allow StrayCare to use your microphone for voice calls."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}